{
  "name": "wibi-mcp-gateway",
  "version": "0.4.1",
  "description": "MCP Gateway multi-tenant que conecta Claude con el CRM WIBI (API v2) mediante OAuth 2.1 por comercio.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wibi-mcp-gateway": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^4.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
