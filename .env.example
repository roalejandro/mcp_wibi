# URL base del API WIBI (sin slash final).
WIBI_BASE_URL=https://apiv2.wibi.com.ar

# API key de la aplicación integradora (tabla `aplicaciones`, approl 1 o 3).
# Identifica la app MCP, NO al comercio.
WIBI_API_KEY=

# Timeout HTTP en ms (opcional, default 30000).
# WIBI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Modo stdio (desarrollo local / Cursor con proceso local)
# ---------------------------------------------------------------------------
# WIBI_USER=
# WIBI_PASS=
# WIBI_DEFAULT_CAMPANIA=

# ---------------------------------------------------------------------------
# Modo HTTP + OAuth multi-tenant (producción / claude.ai)
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=http
# Temporal (prueba sin DNS mcp): https://wibi.com.ar
# Objetivo (cuando el jefe cree A mcp → 191.234.207.236 en DonWeb): https://mcp.wibi.com.ar
# WIBI_PUBLIC_URL=https://wibi.com.ar
# WIBI_HTTP_PORT=3939
# WIBI_HTTP_HOST=0.0.0.0
# WIBI_ACCESS_TOKEN_TTL=3600
# WIBI_TRUST_PROXY=1
#
# En modo HTTP NO se usan WIBI_USER / WIBI_PASS / MCP_HTTP_TOKEN.
# Cada comercio inicia sesión con su propio usuario/clave en la pantalla OAuth.
#
# Persistencia OAuth (clients DCR + access/refresh + WibiSession):
# - memory: desarrollo local (default). No sobrevive recreate del proceso.
# - redis: producción / Docker. Fail-fast si Redis no conecta.
# OAUTH_STORE=memory
#
# En docker-compose.yml se fuerza OAUTH_STORE=redis y REDIS_URL autenticada.
# Definí un password fuerte en el .env de producción (no lo subas al repo):
# REDIS_PASSWORD=cambiar-por-un-password-fuerte
# REDIS_URL=redis://:cambiar-por-un-password-fuerte@redis:6379
#
# Desarrollo local sin Redis: dejar OAUTH_STORE=memory (o no definirla).
