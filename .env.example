# URL base del API WIBI (producción usa el dominio custom).
WIBI_BASE_URL=https://apiv2.wibi.com.ar

# API key de la aplicación integradora (fila en tabla `aplicaciones`, approl 1 o 3).
WIBI_API_KEY=

# Credenciales del comercio (tabla `comercios`: Usuario / Clave).
WIBI_USER=
WIBI_PASS=

# Opcional: campaña por defecto cuando el comercio opera varias campañas.
# WIBI_DEFAULT_CAMPANIA=
